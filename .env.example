# ==============================================================================
# DataFlow System Configuration
# ==============================================================================

# Environment: development | staging | production | test
ENVIRONMENT=development
DEBUG=false
APP_NAME=DataFlow
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Security & Authentication
# Generate in production using: openssl rand -hex 32
SECRET_KEY=change-this-insecure-secret-key-for-production-use-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dataflow_db
DATABASE_SYNC_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dataflow_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Redis & Background Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
JOB_MAX_RETRIES=3
JOB_RETRY_BACKOFF_SECONDS=5

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_BULK_PER_MINUTE=30

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# Observability & Metrics
PROMETHEUS_METRICS_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Ingestion Batch Limits
MAX_BULK_BATCH_SIZE=5000
CHUNK_PROCESSING_SIZE=500
